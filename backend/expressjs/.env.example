# Copy to .env and fill in real values. Never commit .env.

PORT=5000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cardvault:change_me@localhost:5432/cardvault

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret

# Optional (defaults shown)
JWT_ISSUER=cardvault-api
JWT_AUDIENCE=cardvault-web

# AI cataloging (optional). Leave both unset to run CardVault without AI.
# The internal FastAPI service (backend/fastapi), e.g. http://localhost:8000 locally or a
# private-network address on Railway. Express never calls the AI provider itself.
# AI_SERVICE_URL=http://localhost:8000
# Same value as AI_SERVICE_TOKEN in backend/fastapi/.env (at least 32 characters).
# AI_SERVICE_TOKEN=
# Optional (defaults shown)
AI_SERVICE_TIMEOUT_MS=90000
AI_CATALOG_HOURLY_LIMIT=20

# URL ingestion (optional; defaults shown)
# URL_FETCH_TIMEOUT_MS=10000
# URL_FETCH_MAX_BYTES=5242880
# URL_INGEST_HOURLY_LIMIT=30

# Guest rate limit on Community Catalog reads (optional; defaults shown). Guests (no valid
# session) get this many GET /api/community/cards and /api/community/cards/:id requests per
# client IP per window, shared between the two. Signed-in users are not counted. Counts are in
# memory: they reset when the server restarts.
# GUEST_COMMUNITY_RATE_LIMIT=120
# GUEST_COMMUNITY_RATE_WINDOW_SECONDS=60

# Reverse proxies in front of Express to trust for the client IP (X-Forwarded-For).
# 0 (default, local development): use the connecting address; forwarded headers are ignored.
# 1 on Railway: the edge proxy, plus the Nuxt /api proxy, which forwards X-Forwarded-For
#   unchanged. Never set it higher than the number of proxies you control, or clients can pick
#   their own IP.
# TRUST_PROXY_HOPS=0
