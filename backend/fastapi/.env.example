# CardVault AI service. Copy to .env and fill in real values. Never commit .env.

# Meta Model API key for this project (https://dev.meta.ai). Server-side only.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Catalog model. Muse Ember is the efficient model for bounded extraction and classification.
# Use muse-spark-1.3 if Ember's subject headings are not good enough. Contributor-mode models
# (names containing "contributor") are rejected: they permit training on card text.
MUSE_CATALOG_MODEL=muse-ember-1.0
MUSE_CATALOG_REASONING_EFFORT=low
MUSE_CATALOG_MAX_OUTPUT_TOKENS=4000
CATALOG_MAX_INPUT_CHARS=40000
MUSE_TIMEOUT_SECONDS=40
MUSE_MAX_RETRIES=1

# Shared secret Express sends as "Authorization: Bearer <token>". At least 32 characters; use the
# same value as AI_SERVICE_TOKEN in backend/expressjs/.env. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=
